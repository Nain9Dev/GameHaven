@page "/library"
@implements IAsyncDisposable
@inject StoreClient Store
@inject ToastService Toasts
@inject BrowserEffects Effects

<PageTitle>GameHaven — Biblioteca</PageTitle>

<div class="shell">
    <header class="page-header">
        <h1>Tu biblioteca</h1>
        <p>
            Los juegos que has «comprado» en esta demo. La sesión es anónima y vive solo
            en tu navegador, así que cada visitante tiene su propia biblioteca.
        </p>
    </header>

    @if (Store.Mode == StoreMode.Connecting)
    {
        <div class="game-grid">
            @for (var i = 0; i < 4; i++)
            {
                <div class="skeleton-card" aria-hidden="true">
                    <div class="skeleton-block skeleton-cover"></div>
                    <div class="skeleton-block skeleton-line"></div>
                    <div class="skeleton-block skeleton-line short"></div>
                </div>
            }
        </div>
    }
    else if (OwnedGames.Count == 0)
    {
        <div class="empty-state">
            <h3>Todavía no tienes juegos</h3>
            <p>Completa una compra de prueba en la tienda y aparecerán aquí, listos para lanzarse.</p>
            <a class="btn-primary" href="">Explorar la tienda</a>
        </div>
    }
    else
    {
        <p class="result-count">@OwnedGames.Count @(OwnedGames.Count == 1 ? "juego" : "juegos") en tu colección</p>

        <div class="game-grid" data-library-grid>
            @foreach (var game in OwnedGames)
            {
                <article class="game-card library-card" @key="game.Id" data-tilt-card data-reveal>
                    <div class="game-cover-frame">
                        <img class="game-cover" src="@($"Images/{game.CoverImageUrl}")"
                             alt="@($"Portada de {game.Title}")" loading="lazy" decoding="async"
                             onerror="this.onerror=null;this.src='Images/001-DeathInProgress.png'" />
                        <div class="cover-badges">
                            <span class="genre-badge">@game.Genre</span>
                        </div>
                    </div>

                    <div class="game-info">
                        <h3 class="game-title">@game.Title</h3>
                        <span class="game-developer">@game.Developer</span>

                        <div class="game-actions" style="margin-top:auto; padding-top:1rem;">
                            <button class="btn-primary play-btn btn-block" @onclick="() => Play(game)">
                                Jugar
                            </button>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>

@code {
    private bool effectsNeedRefresh = true;

    private List<GameSummary> OwnedGames =>
        Store.Catalog
            .Where(game => Store.Owns(game.Id))
            .OrderBy(game => game.Title, StringComparer.CurrentCulture)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnStoreChanged;
        await Store.EnsureInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!effectsNeedRefresh) return;
        effectsNeedRefresh = false;

        await Effects.InitTiltAsync("[data-library-grid]");
        await Effects.InitRevealAsync();
    }

    private void OnStoreChanged()
    {
        effectsNeedRefresh = true;
        InvokeAsync(StateHasChanged);
    }

    private void Play(GameSummary game) =>
        Toasts.Info($"Lanzando {game.Title}… (es una demo: aquí no hay ejecutable que arrancar)");

    public async ValueTask DisposeAsync()
    {
        Store.Changed -= OnStoreChanged;
        await Effects.DisposeTiltAsync();
        await Effects.DisposeAsync();
    }
}

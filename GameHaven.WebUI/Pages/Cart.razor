@page "/cart"
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>GameHaven - Carrito</PageTitle>

<div class="store-container" style="padding: 40px 24px;">
    <h2 style="margin-bottom: 24px;">Tu Carrito de Compra</h2>
    
    @if (cart == null)
    {
        <p><em>Cargando...</em></p>
    }
    else if (!cart.Items.Any())
    {
        <div class="empty-state">
            <p>Tu carrito está vacío.</p>
            <button class="btn-primary" @onclick='() => Nav.NavigateTo("/")'>Seguir Comprando</button>
        </div>
    }
    else
    {
        <div class="cart-layout">
            <div class="cart-items">
                @foreach (var item in cart.Items)
                {
                    <div class="cart-item-card">
                        <div class="cart-item-details">
                            <h3>@GetGameTitle(item.GameId)</h3>
                        </div>
                        <div class="cart-item-price">
                            <span class="price-tag">@item.PriceAtAddedTime.ToString("C")</span>
                        </div>
                    </div>
                }
            </div>
            
            <div class="cart-summary">
                <h3>Resumen</h3>
                <div class="summary-row">
                    <span>Total estimado</span>
                    <span class="price-tag" style="font-size: 1.2rem;">@cart.TotalAmount.ToString("C")</span>
                </div>
                <button class="btn-primary" style="width: 100%; margin-top: 24px; padding: 14px;" @onclick="Checkout">
                    Completar Compra
                </button>
            </div>
        </div>
    }
</div>

<style>
    .cart-layout {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 32px;
    }
    .cart-item-card {
        background: rgba(16, 22, 42, 0.6);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(120, 144, 255, 0.2);
        padding: 16px 24px;
        border-radius: 8px;
        margin-bottom: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .cart-summary {
        background: rgba(16, 22, 42, 0.8);
        padding: 24px;
        border-radius: 12px;
        border: 1px solid rgba(120, 144, 255, 0.3);
        height: fit-content;
    }
    .summary-row {
        display: flex;
        justify-content: space-between;
        margin-top: 16px;
        border-top: 1px solid rgba(255,255,255,0.1);
        padding-top: 16px;
    }
</style>

@code {
    private CartDto? cart;
    private GameDto[]? allGames;
    private Guid demoUserId = new Guid("11111111-1111-1111-1111-111111111111");

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        allGames = await Http.GetFromJsonAsync<GameDto[]>("api/games");
        cart = await Http.GetFromJsonAsync<CartDto>($"api/cart/{demoUserId}");
    }

    private string GetGameTitle(Guid gameId)
    {
        return allGames?.FirstOrDefault(g => g.Id == gameId)?.Title ?? "Juego Desconocido";
    }

    private async Task Checkout()
    {
        var response = await Http.PostAsync($"api/cart/{demoUserId}/checkout", null);
        if (response.IsSuccessStatusCode)
        {
            await JS.InvokeVoidAsync("alert", "¡Compra completada con éxito! Los juegos están en tu biblioteca.");
            Nav.NavigateTo("/library");
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("alert", $"Error: {error}");
        }
    }

    public class CartDto
    {
        public Guid UserId { get; set; }
        public decimal TotalAmount { get; set; }
        public List<CartItemDto> Items { get; set; } = new();
    }

    public class CartItemDto
    {
        public Guid GameId { get; set; }
        public decimal PriceAtAddedTime { get; set; }
    }

    public class GameDto
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = "";
    }
}

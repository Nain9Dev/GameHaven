@page "/cart"
@implements IAsyncDisposable
@inject StoreClient Store
@inject ToastService Toasts
@inject BrowserEffects Effects
@inject NavigationManager Nav

<PageTitle>GameHaven — Carrito</PageTitle>

<div class="shell">
    <header class="page-header">
        <h1>Tu carrito</h1>
        <p>
            Compra simulada: no se procesa ningún pago. Al confirmar, los juegos pasan a
            tu biblioteca de demostración.
        </p>
    </header>

    @if (Store.Mode == StoreMode.Connecting)
    {
        <p class="result-count">Cargando carrito…</p>
    }
    else if (Store.CartCount == 0)
    {
        <div class="empty-state">
            <h3>El carrito está vacío</h3>
            <p>Añade algún juego desde la tienda para ver aquí el resumen de la compra.</p>
            <a class="btn-primary" href="">Ir a la tienda</a>
        </div>
    }
    else
    {
        <div class="cart-layout">
            <div>
                @foreach (var line in Store.Cart)
                {
                    var game = Store.Find(line.GameId);
                    <div class="cart-item" @key="line.GameId" data-reveal>
                        <img src="@CoverFor(game)" alt="@($"Portada de {TitleFor(game)}")"
                             loading="lazy"
                             onerror="this.onerror=null;this.src='Images/001-DeathInProgress.png'" />

                        <div>
                            <h3>@TitleFor(game)</h3>
                            @if (game is not null)
                            {
                                <span class="genre-badge">@game.Genre</span>
                            }
                        </div>

                        <div class="cart-item-side">
                            <span class="price-tag">@Money.Format(line.PriceAtAddedTime)</span>
                            <button class="link-danger" type="button"
                                    @onclick="() => RemoveAsync(line.GameId)">
                                Quitar
                            </button>
                        </div>
                    </div>
                }
            </div>

            <aside class="cart-summary" data-reveal>
                <h3>Resumen</h3>

                <div class="summary-row">
                    <span>@Store.CartCount @(Store.CartCount == 1 ? "juego" : "juegos")</span>
                    <span>@Money.Format(Store.CartTotal)</span>
                </div>

                <div class="summary-row">
                    <span>Ahorro por descuentos</span>
                    <span>@Money.Format(Savings)</span>
                </div>

                <div class="summary-row total">
                    <span>Total</span>
                    <span class="price-tag">@Money.Format(Store.CartTotal)</span>
                </div>

                <button class="btn-primary btn-block" style="margin-top:1.25rem;"
                        @onclick="CheckoutAsync" disabled="@isProcessing">
                    @(isProcessing ? "Procesando…" : "Completar compra")
                </button>

                <p class="summary-note">
                    Demostración sin pasarela de pago. No se solicitan ni almacenan datos
                    bancarios en ningún momento.
                </p>
            </aside>
        </div>
    }
</div>

@code {
    private bool isProcessing;
    private bool effectsNeedRefresh = true;

    /// <summary>Difference between list price and the price captured in the cart.</summary>
    private decimal Savings =>
        Store.Cart.Sum(line => (Store.Find(line.GameId)?.BasePrice ?? line.PriceAtAddedTime) - line.PriceAtAddedTime);

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnStoreChanged;
        await Store.EnsureInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!effectsNeedRefresh) return;
        effectsNeedRefresh = false;
        await Effects.InitRevealAsync();
    }

    private void OnStoreChanged()
    {
        effectsNeedRefresh = true;
        InvokeAsync(StateHasChanged);
    }

    private static string TitleFor(GameSummary? game) => game?.Title ?? "Juego no disponible";

    private static string CoverFor(GameSummary? game) =>
        $"Images/{game?.CoverImageUrl ?? "001-DeathInProgress.png"}";

    private async Task RemoveAsync(Guid gameId)
    {
        var result = await Store.RemoveFromCartAsync(gameId);
        if (result.Succeeded) Toasts.Info(result.Message);
        else Toasts.Error(result.Message);
    }

    private async Task CheckoutAsync()
    {
        isProcessing = true;
        var result = await Store.CheckoutAsync();
        isProcessing = false;

        if (result.Succeeded)
        {
            Toasts.Success(result.Message);
            Nav.NavigateTo($"{Nav.BaseUri}library");
        }
        else
        {
            Toasts.Error(result.Message);
        }
    }

    public async ValueTask DisposeAsync()
    {
        Store.Changed -= OnStoreChanged;
        await Effects.DisposeAsync();
    }
}

@page "/"
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>GameHaven - Tienda</PageTitle>

<div class="store-container">
    @if (games == null)
    {
        <p><em>Cargando el catálogo más épico...</em></p>
    }
    else
    {
        <div class="game-grid">
            @foreach (var game in games)
            {
                <div class="game-card">
                    <img src="Images/@game.CoverImageUrl" alt="@game.Title" class="game-cover" onerror="this.src='Images/001-DeathInProgress.png'" />
                    <div class="game-info">
                        <h3 class="game-title">@game.Title</h3>
                        <p class="game-developer">@game.Developer</p>
                        <div class="game-price-row">
                            @if (game.DiscountPercentage > 0)
                            {
                                <span class="discount-badge">-@game.DiscountPercentage%</span>
                                <div>
                                    <span class="price-original">@game.BasePrice.ToString("C")</span>
                                    <span class="price-tag">@game.CurrentPrice.ToString("C")</span>
                                </div>
                            }
                            else
                            {
                                <span></span>
                                <span class="price-tag">@game.BasePrice.ToString("C")</span>
                            }
                        </div>
                        <button class="btn-primary" style="margin-top: 16px; width: 100%;" @onclick="() => AddToCart(game.Id)">
                            Añadir al Carrito
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private GameDto[]? games;
    private Guid demoUserId = new Guid("11111111-1111-1111-1111-111111111111");

    protected override async Task OnInitializedAsync()
    {
        games = await Http.GetFromJsonAsync<GameDto[]>("api/games");
    }

    private async Task AddToCart(Guid gameId)
    {
        var response = await Http.PostAsJsonAsync($"api/cart/{demoUserId}/add", new { GameId = gameId });
        if (response.IsSuccessStatusCode)
        {
            await JS.InvokeVoidAsync("alert", "Juego añadido al carrito.");
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("alert", $"Error: {error}");
        }
    }

    public class GameDto
    {
        public Guid Id { get; set; }
        public string Title { get; set; } = "";
        public string Developer { get; set; } = "";
        public decimal BasePrice { get; set; }
        public decimal CurrentPrice { get; set; }
        public int DiscountPercentage { get; set; }
        public string CoverImageUrl { get; set; } = "";
    }
}
